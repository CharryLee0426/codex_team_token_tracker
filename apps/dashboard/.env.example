# ---- Convex (written by `npx convex dev`; on Vercel set CONVEX_DEPLOY_KEY instead) ----
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=dev:your-deployment
# CONVEX_DEPLOY_KEY=prod:...   # Vercel only – lets `convex deploy --cmd 'next build'` push functions + set the URL

# ---- Clerk (https://dashboard.clerk.com) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ---- App ----
# Public origin of this dashboard; the menu bar app is pointed at it (`codex-tracker login --dashboard <url>`)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Guided tour (dev switch). Unset = opens once per account on the first dashboard visit.
#   force  open on every dashboard load (what `pnpm dev:tour` sets)   off  never open by itself
# NEXT_PUBLIC_ONBOARDING_TOUR=force
# "Since team plan starts" range: when the team's Codex plan began, ISO 8601 with an offset. Default: 2026-08-25 00:00 PDT.
# NEXT_PUBLIC_TEAM_PLAN_START=2026-08-25T00:00:00-07:00

# ---- Set these in the CONVEX dashboard (Settings → Environment Variables), not here ----
# CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev   (Clerk → JWT template "convex" → Issuer)
# CLERK_WEBHOOK_SECRET=whsec_...                                 (Clerk → Webhooks → endpoint https://<deployment>.convex.site/clerk-webhook)
