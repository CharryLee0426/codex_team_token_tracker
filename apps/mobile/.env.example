# Copy to .env.local for --local, or .env.release for --release. Never commit those files.
# --local falls back to ../dashboard/.env.local when mobile/.env.local is absent.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CONVEX_DEPLOYMENT=dev:your-development-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-development-deployment.convex.cloud
# Optional CI credential, scoped to exactly the development deployment above.
# CONVEX_DEPLOY_KEY=dev:your-development-deployment|REPLACE_ME
# --release requires pk_live_..., prod:<deployment-name>, and its matching URL.
# Clerk secret keys are not needed by native builds.
