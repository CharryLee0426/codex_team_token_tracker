{
  "name": "codex-token-tracker",
  "version": "0.2.0",
  "description": "Menu bar / system tray app and headless agent that tracks OpenAI Codex token usage, cache hits, model mix and API-equivalent cost — and syncs it to your team dashboard.",
  "license": "MIT",
  "author": "Chen Li",
  "homepage": "https://codex.chenli.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CharryLee0426/codex_team_token_tracker.git",
    "directory": "packages/menubar"
  },
  "bugs": {
    "url": "https://github.com/CharryLee0426/codex_team_token_tracker/issues"
  },
  "keywords": [
    "codex",
    "openai",
    "tokens",
    "usage",
    "tracker",
    "menubar",
    "tray",
    "electron",
    "convex"
  ],
  "bin": {
    "codex-token-tracker": "bin/codex-tracker.js",
    "codex-tracker": "bin/codex-tracker.js"
  },
  "main": "dist/main.js",
  "files": [
    "bin",
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "win32",
    "linux"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node bin/codex-tracker.js",
    "prepublishOnly": "pnpm build && pnpm typecheck",
    "build:icons": "node scripts/gen-icons.mjs",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "menubar": "^9.5.3"
  },
  "optionalDependencies": {
    "electron": "^38.8.6"
  },
  "devDependencies": {
    "@codex-tracker/backend": "workspace:*",
    "@codex-tracker/shared": "workspace:*",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "convex": "^1.45.0",
    "esbuild": "^0.28.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "~5.9.3"
  }
}
